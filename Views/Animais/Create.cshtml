
@model SistemaAdocaoAnimais.Models.Animal

@{
    ViewData["Title"] = "Cadastrar Animal";
}

<div class="container py-4">
    <h1>Cadastrar Animal</h1>
    <p class="text-muted">Preencha os dados do animal para disponibilizá-lo para adoção.</p>

    <form asp-controller="Animais" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome do animal</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Especie" class="form-label">Espécie</label>
            <select asp-for="Especie" class="form-select">
                <option value="">Selecione</option>
                <option value="Cachorro">Cachorro</option>
                <option value="Gato">Gato</option>
                <option value="Coelho">Coelho</option>
                <option value="Outro">Outro</option>
            </select>
            <span asp-validation-for="Especie" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Raca" class="form-label">Raça</label>
            <input asp-for="Raca" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Idade" class="form-label">Idade (anos)</label>
            <input asp-for="Idade" type="number" min="0" max="100" class="form-control" />
            <span asp-validation-for="Idade" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DataEntrada" class="form-label">Data de entrada</label>
            <input asp-for="DataEntrada" type="date" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Porte" class="form-label">Porte</label>
            <select asp-for="Porte" class="form-select">
                <option value="">Selecione</option>
                <option value="Pequeno">Pequeno</option>
                <option value="Médio">Médio</option>
                <option value="Grande">Grande</option>
            </select>
            <span asp-validation-for="Porte" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status da adoção</label>
            <select asp-for="Status"
                    asp-items="Html.GetEnumSelectList<SistemaAdocaoAnimais.Models.StatusAdocao>()"
                    class="form-select">
            </select>
        </div>

        <button type="submit" class="btn btn-success">Salvar animal</button>
        <a asp-controller="Animais" asp-action="Index" class="btn btn-secondary">Voltar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

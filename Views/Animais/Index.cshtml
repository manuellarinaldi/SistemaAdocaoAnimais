
@model List<SistemaAdocaoAnimais.Models.Animal>

@{
    ViewData["Title"] = "Adoção de Animais";
}

<div class="container py-4">
    <h1 class="mb-2">🐾 Adoção de Animais</h1>
    <p class="text-muted">
        Encontre seu novo melhor amigo!
    </p>

    <div class="mb-4">
        <a asp-action="Create" class="btn btn-success">
            Cadastrar animal
        </a>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="pesquisa"
                   value="@ViewBag.Pesquisa"
                   class="form-control"
                   placeholder="Pesquisar por nome ou espécie..." />

            <button type="submit" class="btn btn-primary">
                Pesquisar
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Limpar
            </a>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Nenhum animal encontrado. Cadastre o primeiro!
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Espécie</th>
                        <th>Raça</th>
                        <th>Idade</th>
                        <th>Porte</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var animal in Model)
                    {
                        <tr>
                            <td>@animal.Nome</td>
                            <td>@animal.Especie</td>
                            <td>@(string.IsNullOrWhiteSpace(animal.Raca) ? "Não informada" : animal.Raca)</td>
                            <td>@animal.Idade anos</td>
                            <td>@animal.Porte</td>
                            <td><status-badge valor="@animal.Status"></status-badge></td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@animal.Id"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@animal.Id"
                                   class="btn btn-sm btn-danger">
                                    Excluir
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
